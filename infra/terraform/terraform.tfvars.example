gcp_project_id = "seu-project-id-no-gcp"
gcp_region     = "us-central1"
gcp_zone       = "us-central1-a"
project_name   = "arborgrid-mvp"
machine_type   = "e2-medium"
domain         = "arborgrid.duckdns.org"

# IP ja reservado para o qual o DNS aponta (remova na primeira criacao para alocar um novo)
static_ip_address = "34.0.0.10"

# Quem administra a VM por IAP + OS Login (sem chave SSH fixa)
admin_principals = ["user:voce@gmail.com"]

# Repositorio autorizado a fazer o deploy via Workload Identity Federation
github_repository = "LM2124/Fiap-2026-GS2-CitizenTech-Projeto-Arborgrid"
