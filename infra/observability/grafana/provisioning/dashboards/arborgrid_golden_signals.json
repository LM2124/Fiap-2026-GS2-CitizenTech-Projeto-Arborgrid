      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "arborgrid_trees_loaded",
          "legendFormat": "Trees"
        }
      ]
    },
    {
      "id": 6,
      "title": "Registros sincronizados da camada Gold (Big Data)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "arborgrid_gold_scores_loaded",
          "legendFormat": "Gold Scores"
        }
      ]
    },
    {
      "id": 7,
      "title": "Assistente: respostas por modo (LLM ou regras)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
