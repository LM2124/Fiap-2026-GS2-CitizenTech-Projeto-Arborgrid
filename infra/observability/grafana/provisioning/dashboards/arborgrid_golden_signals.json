{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "1. Traffic — Requisicoes por Segundo (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(arborgrid_http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "2. Latency — P50 e P95 (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(arborgrid_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(arborgrid_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 3,
      "title": "3. Errors — Taxa de Erros 4xx/5xx (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(arborgrid_http_errors_total[1m])) by (error_class)",
          "legendFormat": "{{error_class}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "4. Saturation — Requisicoes Simultaneas & Memoria Residente (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "arborgrid_inprogress_requests",
          "legendFormat": "In-Flight Requests"
        },
        {
          "expr": "process_resident_memory_bytes / 1048576",
          "legendFormat": "RSS Memory (MB)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Arvores GeoSampa Carregadas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "arborgrid_trees_loaded", "legendFormat": "Trees" }
      ]
    },
    {
      "id": 6,
      "title": "Registros Sincronizados da Camada Gold (Big Data)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "arborgrid_gold_scores_loaded", "legendFormat": "Gold Scores" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "title": "ArborGrid — 4 Golden Signals & Telemetria MVP",
  "uid": "arborgrid-golden-signals",
  "version": 1
}
