  "panels": [
    {
      "id": 1,
      "title": "1. Tráfego: requisições por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(arborgrid_http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "2. Latência: P50 e P95 (segundos)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(arborgrid_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(arborgrid_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 3,
      "title": "3. Erros: respostas 4xx e 5xx por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(arborgrid_http_errors_total[1m])) by (error_class)",
          "legendFormat": "{{error_class}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "4. Saturação: requisições simultâneas e memória residente (MB)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "arborgrid_inprogress_requests",
          "legendFormat": "In-Flight Requests"
        },
        {
          "expr": "process_resident_memory_bytes / 1048576",
          "legendFormat": "RSS Memory (MB)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Árvores do GeoSampa carregadas",
