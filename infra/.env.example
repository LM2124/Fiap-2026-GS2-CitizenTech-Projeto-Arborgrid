# Copie para .env antes de subir localmente com `docker compose --env-file .env up -d --build`
# NUNCA versione arquivos .env no Git.

ARBORGRID_API_TOKEN=substitua_por_token_aleatorio_longo
ARBORGRID_EXPOSE_MEDIA_URLS=false
# Controla se o endpoint publico /api/v1/gold/seed-demo permite carregar dados demonstrativos (false em producao)
ARBORGRID_ALLOW_DEMO_SEED=false
ARBORGRID_MEDIA_HOST_DIR=../arborgrid-vision/dataset/sp_geosampa_api
ARBORGRID_LLM_MODELS_DIR=../llm-assistant/models
ARBORGRID_VISION_MODELS_DIR=../arborgrid-vision/models
# Em producao o deploy do CI grava aqui o digest publicado no Artifact Registry
# (ex.: us-central1-docker.pkg.dev/<projeto>/arborgrid/webapp@sha256:...); local usa o build
ARBORGRID_WEBAPP_IMAGE=arborgrid-webapp:latest
COMPOSE_PROFILES=llm
# Timeout da chamada ao LLM (s). Em CPU pequena uma resposta leva de 40 s a 2 min; o Nginx espera 150 s.
ARBORGRID_LLM_TIMEOUT_SECONDS=110
# Dominio publico com HTTPS automatico pelo Caddy (precisa apontar para o IP estatico da VM)
ARBORGRID_DOMAIN=arborgrid.duckdns.org
LLAMA_THREADS=2

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=substitua_por_senha_forte_grafana
