{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ArborGrid: Subir Stack Completa (Docker)",
      "type": "shell",
      "command": "python3 scripts/start_stack.py",
      "windows": {
        "command": "python scripts/start_stack.py"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ArborGrid: Subir API Local (Sem Docker - Porta 8000)",
      "type": "shell",
      "command": "python3 scripts/start_stack.py --local-api",
      "windows": {
        "command": "python scripts/start_stack.py --local-api"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ArborGrid: Derrubar Stack Docker",
      "type": "shell",
      "command": "python3 scripts/start_stack.py --down",
      "windows": {
        "command": "python scripts/start_stack.py --down"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ArborGrid: Rodar Testes API (pytest)",
      "type": "shell",
      "command": "uv run pytest -v",
      "options": {
        "cwd": "${workspaceFolder}/webapp"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "ArborGrid: Build Frontend (Vite)",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/webapp/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloud: Túnel do Grafana e do Prometheus (deixe aberto)",
      "type": "shell",
      "command": "python3 scripts/deploy_vm.py tunnel",
      "windows": {
        "command": "python scripts/deploy_vm.py tunnel"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "Cloud: Abrir Grafana (precisa do túnel)",
      "type": "shell",
      "command": "xdg-open http://127.0.0.1:13000",
      "osx": {
        "command": "open http://127.0.0.1:13000"
      },
      "windows": {
        "command": "Start-Process http://127.0.0.1:13000"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Cloud: Abrir Prometheus (precisa do túnel)",
      "type": "shell",
      "command": "xdg-open http://127.0.0.1:19090",
      "osx": {
        "command": "open http://127.0.0.1:19090"
      },
      "windows": {
        "command": "Start-Process http://127.0.0.1:19090"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Cloud: Terminal na VM (IAP + OS Login)",
      "type": "shell",
      "command": "python3 scripts/deploy_vm.py shell",
      "windows": {
        "command": "python scripts/deploy_vm.py shell"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Cloud: Terraform plan",
      "type": "shell",
      "command": "terraform -chdir=infra/terraform plan",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Cloud: Últimos runs do pipeline",
      "type": "shell",
      "command": "gh run list --workflow devsecops.yml --limit 5",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
